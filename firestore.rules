rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Function to check if the user is a member of the business
    function isBusinessMember(businessId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/businesses/$(businessId)/memberships/$(request.auth.uid));
    }

    // Function to check if the user is the owner of the business
    function isBusinessOwner(businessId) {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/businesses/$(businessId)/memberships/$(request.auth.uid)).data.role == "OWNER";
    }
    
    // Users Collection (Users can only read and write their own document)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Businesses Collection
    match /businesses/{businessId} {
      // Any authenticated user can create a business
      allow create: if isAuthenticated();
      
      // Only members can read the business details
      allow read: if isBusinessMember(businessId);
      
      // Only owners can update business details
      allow update: if isBusinessOwner(businessId);
      allow delete: if false; // Deletion is not allowed from client
      
      // Subcollections under Businesses
      
      // Memberships
      match /memberships/{membershipId} {
        // Members can read memberships for their business
        allow read: if isBusinessMember(businessId);
        // Only owners can manage memberships (invite, change roles)
        allow write: if isBusinessOwner(businessId) || request.auth.uid == request.resource.data.userId; 
        // The second condition allows a user to write their own initial membership during business creation
      }
      
      // Subscriptions
      match /subscription/{subId} {
        // Members can view subscription status
        allow read: if isBusinessMember(businessId);
        // Only owners can manage subscription (or backend through Admin SDK)
        allow write: if isBusinessOwner(businessId);
      }
      
      // Operational Data (Tractors, Jobs, Expenses, Customers, Withdrawals, Partners)
      // All members can read and write these as they are synced locally and pushed
      match /tractors/{tractorId} {
        allow read, write: if isBusinessMember(businessId);
      }
      match /jobs/{jobId} {
        allow read, write: if isBusinessMember(businessId);
      }
      match /expenses/{expenseId} {
        allow read, write: if isBusinessMember(businessId);
      }
      match /withdrawals/{withdrawalId} {
        allow read, write: if isBusinessMember(businessId);
      }
      match /customers/{customerId} {
        allow read, write: if isBusinessMember(businessId);
      }
      match /partners/{partnerId} {
        allow read, write: if isBusinessMember(businessId);
      }
      // members collection (legacy backwards compatibility if used)
      match /members/{memberUid} {
        allow read, write: if isBusinessMember(businessId) || request.auth.uid == memberUid;
      }
    }
    
    // Group queries (if any)
    match /{path=**}/memberships/{membershipId} {
      // Allow users to query their own memberships across all businesses
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
